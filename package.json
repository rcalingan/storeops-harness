{
  "name": "storeops",
  "version": "0.1.0",
  "description": "StoreOps — Retail Store Operations Management REST API (capstone reference codebase — do not use in production)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "tsc --noEmit && eslint . && depcruise src --config .dependency-cruiser.cjs && jest --coverage"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/server.ts",
      "!src/seed.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80,
        "functions": 75,
        "branches": 65
      }
    }
  },
  "dependencies": {
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@types/supertest": "^6.0.3",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
